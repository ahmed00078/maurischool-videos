{
  "name": "mauri-school-promo-video",
  "version": "1.0.0",
  "private": true,
  "description": "MauriSchool 30-second vertical sales video (WhatsApp), built with Remotion",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render Promo out/mauri-school-promo.mp4 --codec=h264 --crf=23",
    "render:wide": "remotion render PromoWide out/mauri-school-promo-wide.mp4 --codec=h264 --crf=23",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "@remotion/google-fonts": "4.0.529",
    "@remotion/media": "4.0.529",
    "@remotion/transitions": "4.0.529",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "19.1.0",
    "typescript": "5.8.3"
  }
}
